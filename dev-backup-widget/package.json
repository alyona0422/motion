{
  "name": "dev-backup-widget",
  "version": "1.0.0",
  "description": "Local dev server + floating widget to back up project source to GitHub (respecting .gitignore)",
  "type": "module",
  "bin": {
    "dev-backup": "./bin/dev-backup.js"
  },
  "files": [
    "bin",
    "lib",
    "widget",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/dev-backup.js serve",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "github",
    "backup",
    "dev",
    "widget",
    "gitignore"
  ],
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "ignore": "^6.0.2"
  }
}
